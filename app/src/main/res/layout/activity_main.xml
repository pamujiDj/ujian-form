<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:filterTouchesWhenObscured="true">

    <!-- ===================== LAYAR AWAL ===================== -->
    <ScrollView
        android:id="@+id/startScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="32dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Logo IKHLAS LOCK"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="IKHLAS LOCK"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ILOK • CBT SPENNEMA • SMP Negeri 45 Surabaya"
                android:textColor="#9DB4FF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/cardRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡  Tata Tertib Ujian"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Ujian hanya bisa dikerjakan lewat aplikasi ini.\n• Layar dikunci. Aplikasi lain tidak dapat dibuka.\n• Screenshot dan rekam layar diblokir.\n• Menyalin dan menempel teks dinonaktifkan.\n• Keluar dari layar ujian dicatat sebagai pelanggaran.\n• 3 pelanggaran akan mengunci ujian sampai pengawas membukanya."
                    android:textColor="#D5DEFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStartInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#FDA4AF"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="MULAI UJIAN"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ILOK v1.1"
                android:textColor="#6F7DB8"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===================== LAYAR UJIAN ===================== -->
    <LinearLayout
        android:id="@+id/examScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <!-- Ketuk 5x untuk membuka dialog PIN pengawas -->
            <ImageView
                android:id="@+id/imgHeaderLogo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_small" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="🔒 ILOK • Ujian Aman"
                android:textColor="#E6ECFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViolation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:text="Pelanggaran 0/3"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:filterTouchesWhenObscured="true" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressTint="#3B82F6"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_banner"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Halaman error / tidak ada koneksi -->
            <LinearLayout
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_main"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tidak dapat terhubung"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvErrorMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Periksa koneksi internet Anda."
                    android:textColor="#B8C6FF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button"
                    android:stateListAnimator="@null"
                    android:text="COBA LAGI"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===================== OVERLAY PIN PENGAWAS ===================== -->
    <LinearLayout
        android:id="@+id/lockView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#B8C6FF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="PIN pengawas"
            android:imeOptions="actionDone|flagNoPersonalizedLearning"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#7080C0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PIN salah"
            android:textColor="#FDA4AF"
            android:textSize="13sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:text="BUKA"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLockCancel"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:text="BATAL"
            android:textColor="#C7D2FE" />
    </LinearLayout>
</FrameLayout>
